{
  "name": "german-study-app",
  "version": "1.0.0",
  "private": true,
  "description": "每日德語：用自己的單字表學德文（網頁版 + iOS App）",
  "scripts": {
    "build": "node scripts/build-www.js",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "serve": "python3 -m http.server 8000"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3"
  }
}
